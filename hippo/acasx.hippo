val min = math.min;
val max = math.max;
val abs = math.abs;

///////////////
// Variables //
///////////////

// Real hp: Puck height
// Real rp: Puck radius
// Real alo: Minimal vertical acceleration, typically g/4

val wLo = 1; // Lower velocity bound
val wUp = -1; // Upper velocity bound

val minI = dLt(v, w){ min__(0, v * w) };
val maxI = dLt(v, w, vlo){ max__(0, w * (vlo - v)) };

val Limpl = dLf(r, h, v, w, vlo, rv){
  \forall t \forall ro \forall ho (
      (0 <= t & t < maxI__(v,w,vlo)/alo & ro = rv * t & ho = (w * alo)/2 * t^2 + v * t)
    | (t >= maxI__(v,w,vlo)/alo & ro = rv * t & ho = vlo * t - w * maxI__(v,w,vlo)^2/(2*alo))
    -> (abs__(r - ro) > rp | w * h < w * ho - hp)
  )
};

val init = dLf(rv){ rp>=0 & hp>0 & rv>=0 & alo>0 };

val loopInv = dLf(r, h, v, w, vlo, rv) { (w=wUp__ | w=wLo__) & Limpl__(r,h,v,w,vlo,rv) };

val motion = dLp{ { r'=-rv, h'=-v, v'=a & w*v>=w*vlo | w*a>=alo } };

//////////////////////////////////////
// Lemma: Safe use case lower bound //
//////////////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction

val safeUseCaseLowerBound = verified theorem
  dLs{ ==> loopInv__(r, h, v, w, vlo, rv) & init__(rv) -> abs__(r)>rp | abs__(h)>hp }
  by backward
  := belle.implyR(1)
  :< belle.andL(-1)
  :< belle.andL(-2)
  :< belle.andL(-3)
  :< belle.andL(-4)
  :< belle.andL(-1)
  :< belle.allL(-6, dLt{ 0 })
  :< belle.allL(-6, dLt{ 0 })
  :< belle.allL(-6, dLt{ 0 })
  :< belle.fullSimplify
  :< belle.implyL(-6)[
    belle.QE[],
    belle.QE[],
  ];

print("safeUseCaseLowerBound proved");

/////////////////////////////
// Lemma: Safe lower bound //
/////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity bound
//
// a

val safeLowerBound = theorem
  dLs{
  ==>
      (w*v >= w*vlo | w*a >= alo)
    & (w=wUp__ | w=wLo__)
    & Limpl__(r, h, v, w, vlo, rv)
    & init__(rv)
    ->
    [motion__;]((w=wUp__ | w=wLo__) & Limpl__(r, h, v, w, vlo, rv))
  }
  by backward -> $conclusion {
    $conclusion
    := belle.implyR(1)
    :< belle.boxAnd(1)
    :< belle.andR(1)[
      belle.GV(1) :< belle.propClose[], // [motion;](w=wUp | w=wLo)
      _, // [motion;]Limpl
    ]
    :< belle.solve(1)
    :< belle.allR(1)
    :< belle.implyR(1)
    :< belle.implyR(1)
    :< belle.allL(-3, dLt{ t_ })
    :< belle.simplify(-3)
    :< belle.allR(1)
    :< belle.allR(1)
    :< belle.allR(1)
    :< belle.andL(-1)
    :< belle.andL(-4)
    :< belle.andL(-5)
    :< belle.allL(-5, dLt{ t_+1 })
    :< belle.allL(-5, dLt{ rv*(t_+t) })
    :< belle.cut(dLf{ 0<=t+t_ & t+t_<maxI__(v,w,vlo)/alo() | t+t_>=maxI__(v,w,vlo)/alo() })[
      $use,
      $show,
    ];

    $show
    := belle.implyR(1)
    :< core.Keep(list(-1, -4, -6, -7, 1))
    :< belle.QE[];

    $use
    := belle.implyR(1)
    :< belle.orL(-7)[$orL, $orR];

    $orL
    := belle.allL(-5, dLt{ w*alo()/2*(t+t_)^2+v*(t+t_) })
    :< belle.implyL(-5)[
      belle.orR(2)
      :< core.Keep(list(-1, -2, -3, -4, -6, -7, 2))
      // :< belle.QE[],
      :< core.Sorry[],

      belle.prop[
        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
        core.Sorry[], belle.QE[], belle.QE[], core.Sorry[], belle.QE[],
        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
        belle.QE[], belle.QE[],
      ],
    ];

    $orR
    := belle.orR(1)
    :< belle.allL(-5, dLt{ vlo*(t+t_)-w*maxI__(v,w,vlo)^2/(2*alo()) })
    :< belle.implyL(-5)[
      belle.orR(3)
      :< core.Keep(list(-1, -6, -7, 4))
      // :< belle.QE[],
      :< core.Sorry[],

      belle.prop[
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        belle.QE[],
        core.Sorry[], // Counterexample
        belle.QE[],
        belle.QE[],
        core.Sorry[], // Counterexample
        belle.QE[],
        belle.QE[],
        core.Sorry[], // Takes forever
        core.Sorry[], // Takes forever
        core.Sorry[], // Counterexample
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
        core.Sorry[],
//        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
//        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
//        core.Sorry[], belle.QE[], belle.QE[], core.Sorry[], belle.QE[],
//        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
//        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
//        belle.QE[], belle.QE[], belle.QE[], belle.QE[], belle.QE[],
//        belle.QE[], belle.QE[],
      ],
    ];
  };

print("safeLowerBound proved");

