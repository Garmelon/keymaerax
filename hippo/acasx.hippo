val min = math.min;
val max = math.max;
val abs = math.abs;

///////////////
// Variables //
///////////////

// Real hp: Puck height
// Real rp: Puck radius
// Real alo: Minimal vertical acceleration, typically g/4

val wLo = 1; // Lower velocity bound
val wUp = -1; // Upper velocity bound

val minI = dLt(v, w){ min__(0, v * w) };
val maxI = dLt(v, w, vlo){ max__(0, w * (vlo - v)) };

val Limpl = dLf(r, h, v, w, vlo, rv){
  \forall t \forall ro \forall ho (
      (0 <= t & t < maxI__(v,w,vlo)/alo() & ro = rv * t & ho = (w * alo())/2 * t^2 + v * t)
    | (t >= maxI__(v,w,vlo)/alo() & ro = rv * t & ho = vlo * t - w * maxI__(v,w,vlo)^2/(2*alo()))
    -> (abs__(r - ro) > rp() | w * h < w * ho - hp())
  )
};

val init = dLf(rv){ rp()>=0 & hp()>0 & rv>=0 & alo()>0 };

val loopInv = dLf(r, h, v, w, vlo, rv) { (w=wUp__ | w=wLo__) & Limpl__(r,h,v,w,vlo,rv) };

val motion = dLp{ { r'=-rv, h'=-v, v'=a & w*v>=w*vlo | w*a>=alo() } };

//////////////////////////////////////
// Lemma: Safe use case lower bound //
//////////////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction

val lem_safeUseCaseLowerBound = verified theorem
  dLs{
    loopInv__(r, h, v, w, vlo, rv),
    init__(rv)
  ==>
    abs__(r)>rp() | abs__(h)>hp()
  }
  by backward :=
  core.Expand("init__", "loopInv__") :<
  belle.andL(-2) :<
  belle.andL(-3) :<
  belle.andL(-4) :<
  belle.andL(-1) :<
  core.Expand("Limpl__") :<
  belle.allL(-6, dLt{ 0 }) :<
  belle.allL(-6, dLt{ 0 }) :<
  belle.allL(-6, dLt{ 0 }) :<
  belle.fullSimplify :<
  belle.implyL(-6)[
    core.ExpandAll :< belle.QE[],
    core.ExpandAll :< belle.QE[],
  ];

print("lem_safeUseCaseLowerBound proved");

/////////////////////////////
// Lemma: Safe lower bound //
/////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity bound
//
// a

val lem_safeLowerBound = verified theorem
  dLs{
  ==>
      (w*v >= w*vlo | w*a >= alo())
    & (w=wUp__ | w=wLo__)
    & Limpl__(r, h, v, w, vlo, rv)
    & init__(rv)
    ->
    [motion__;]((w=wUp__ | w=wLo__) & Limpl__(r, h, v, w, vlo, rv))
  }
  by backward -> $conclusion {
    $conclusion :=
    belle.implyR(1) :<
    belle.boxAnd(1) :<
    belle.andR(1)[
      // [motion](w=wUp|w=wLo)
      core.Expand("motion__") :<
      belle.GV(1) :<
      belle.propClose[],

      // [motion]Limpl
      _,
    ] :<
    core.Expand("motion__") :<
    belle.solve(1) :<
    belle.allR(1) :<
    belle.implyR(1) :<
    belle.implyR(1) :<
    belle.allL(-3, dLt{ t_ }) :<
    belle.simplify(-3) :<
    core.Expand("Limpl__") :<
    belle.allR(1) :<
    belle.allR(1) :<
    belle.allR(1) :<
    belle.andL(-1) :<
    belle.andL(-4) :<
    belle.andL(-5) :<
    belle.allL(-5, dLt{ t_+t }) :<
    belle.allL(-5, dLt{ rv*(t_+t) }) :<
    belle.cut(dLf{
      0 <= t+t_ & t+t_ < maxI__(v,w,vlo) / alo() | t+t_ >= maxI__(v,w,vlo) / alo()
    })[$use, $show];

    $show :=
    belle.implyR(1) :<
    core.Keep(-1, -4, -6, -7, 1) :<
    core.ExpandAll :<
    belle.QE[];

    $use :=
    belle.implyR(1) :<
    belle.orL(-7)[
      // 0<=t+t_&t+t_ < maxI__(v,w,vlo)/alo()
      belle.allL(-5, dLt{ w*alo()/2*(t+t_)^2+v*(t+t_) }) :<
      belle.implyL(-5)[
        belle.orR(2) :<
        core.Keep(-1, -2, -3, -4, -6, -7, 2) :<
        core.ExpandAll :<
        belle.QE[],

        belle.prop[
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
        ],
      ],

      // t+t_>=maxI__(v,w,vlo)/alo()
      belle.orR(1) :<
      belle.allL(-5, dLt{ vlo*(t+t_)-w*maxI__(v,w,vlo)^2/(2*alo()) }) :<
      belle.implyL(-5)[
        belle.orR(3) :<
        core.Keep(-1, -6, -7, 4) :<
        core.ExpandAll :<
        belle.QE[],

        belle.prop[
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
            core.ExpandAll :< belle.QE[],
        ],
      ],
    ];
  };

print("lem_safeLowerBound proved");

/////////////////////////////////////////////////////
// Theorem 1: Correctness of implicit safe regions //
/////////////////////////////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction
//
// a

val thm1_correctnessOfImplicitSafeRegions = verified theorem
  dLs{
  ==>
      init__(rv)
    & ( (w=wUp__ | w=wLo__) & Limpl__(r,h,v,w,vlo,rv) )
    ->
    [{ {
       { ?true;
         ++
         {{ w:=wUp__; ++ w:=wLo__; }
          vlo := *;
          ?Limpl__(r,h,v,w,vlo,rv);
         }
       }
       a := *;
       }
       motion__;
     }*
    ] ( (abs__(r) > rp() | abs__(h) > hp()) & Limpl__(r,h,v,w,vlo,rv) )
  }
  by backward -> $conclusion {
    $conclusion :=
    belle.implyR(1) :<
    belle.andL(-1) :<
    belle.andL(-2) :<
    core.Expand("init__", "motion__") :<
    belle.loop(1, dLf{ loopInv__(r,h,v,w,vlo,rv) })[$init, $post, $step];

    $init :=
    core.ExpandAll :<
    belle.propClose[];

    $post :=
    belle.andR(1)[
      // abs__(r)>rp()|abs__(h)>hp()
      core.Use(lem_safeUseCaseLowerBound)[],

      // Limpl__(r,h,v,w,vlo,rv)
      core.ExpandAll :<
      belle.propClose[],
    ];

    $step :=
    belle.composeb(1) :<
    belle.MR(1, dLf{ loopInv__(r,h,v,w,vlo,rv) & init__(rv) })[
      belle.chaseAt(1) :<
      core.ExpandAll :<
      belle.simplify(1) :<
      belle.closeT[],

      belle.diffUnpackEvolDomain(1) :<
      core.Use(lem_safeLowerBound)[],
    ];
  };

print("thm1_correctnessOfImplicitSafeRegions proved");
