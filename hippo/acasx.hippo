print("ACAS X");
print("======");
print();

////////////////////////
// Should-be-builtins //
////////////////////////

val min = dLt(x, y) { min<< (._1 < ._2 & ._0 = ._1) | (._1 >= ._2 & ._0 = ._2) >>(x, y) };
val max = dLt(x, y) { min<< (._1 < ._2 & ._0 = ._2) | (._1 >= ._2 & ._0 = ._1) >>(x, y) };
val abs = dLt(x) { abs<< (._1 < 0 & ._0 = -(._1)) | (._1 >= 0 & ._0 = ._1) >>(x) };

///////////////
// Variables //
///////////////

// Real hp: Puck height
// Real rp: Puck radius
// Real alo: Minimal vertical acceleration, typically g/4

val wLo = 1; // Lower velocity bound
val wUp = -1; // Upper velocity bound

val minI = dLt(v, w) { min__(0, v * w) };
val maxI = dLt(v, w, vlo) { max__(0, w * (vlo - v)) };

val Limpl = dLf(r, h, v, w, vlo, rv) {
  \forall t \forall ro \forall ho (
      (0 <= t & t < maxI__(v,w,vlo)/alo & ro = rv * t & ho = (w * alo)/2 * t^2 + v * t)
    | (t >= maxI__(v,w,vlo)/alo & ro = rv * t & ho = vlo * t - w * maxI__(v,w,vlo)^2/(2*alo))
    -> (abs__(r - ro) > rp | w * h < w * ho - hp)
  )
};

val init = dLf(rv) { rp>=0 & hp>0 & rv>=0 & alo>0 };

val loopInv = dLf(r, h, v, w, vlo, rv) { (w=wUp | w=wLo) & Limpl__(r,h,v,w,vlo,rv) };

val motion = dLp{ { r' = -rv, h' = -v, v' = a & w*v>=w*vlo|w*a>=alo } };

print();
print("Variables");
print("---------");
print();
print("      wLo: ", wLo);
print("      wUp: ", wUp);
print("     minI: ", minI);
print("     maxI: ", maxI);
print("    Limpl: ", Limpl);
print("     init: ", init);
print("  loopInv: ", loopInv);
print("   motion: ", motion);
print();

//////////////////////////////////////
// Lemma: Safe use case lower bound //
//////////////////////////////////////

print();
print("Safe use case lower bound");
print("-------------------------");
print();

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical verlocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction

val safeUseCaseLowerBound = theorem
  dLs{ ==> loopInv__(r, h, v, w, vlo, rv) & init__(rv) -> abs__(r)>rp | abs__(h)>hp }
  by backward
  := belle.implyR(1)
  :< belle.andL(-1)
  :< belle.andL(-2)
  :< belle.andL(-3)
  :< belle.andL(-4)
  :< belle.andL(-1)
  :< belle.allL(-6, dLt{ 0 })
  :< belle.allL(-6, dLt{ 0 })
  :< belle.allL(-6, dLt{ 0 })
  :< belle.fullSimplify()
  :< belle.implyL(-6)[
    // These QEs should resolve the goals according to the original proof,
    // but instead return false.
    belle.QE() :< core.Sorry()[],
    belle.QE() :< core.Sorry()[],
  ];

print(safeUseCaseLowerBound.conclusion);
