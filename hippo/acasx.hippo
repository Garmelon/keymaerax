val min = math.min;
val max = math.max;
val abs = math.abs;

///////////////
// Variables //
///////////////

// Real hp: Puck height
// Real rp: Puck radius
// Real alo: Minimal vertical acceleration, typically g/4

val wLo = 1; // Lower velocity bound
val wUp = -1; // Upper velocity bound

val minI = dLt(v, w){ min__(0, v * w) };
val maxI = dLt(v, w, vlo){ max__(0, w * (vlo - v)) };

val Limpl = dLf(r, h, v, w, vlo, rv){
  \forall t \forall ro \forall ho (
      (0 <= t & t < maxI__(v,w,vlo)/alo() & ro = rv * t & ho = (w * alo())/2 * t^2 + v * t)
    | (t >= maxI__(v,w,vlo)/alo() & ro = rv * t & ho = vlo * t - w * maxI__(v,w,vlo)^2/(2*alo()))
    -> (abs__(r - ro) > rp() | w * h < w * ho - hp())
  )
};

val init = dLf(rv){ rp()>=0 & hp()>0 & rv>=0 & alo()>0 };

val loopInv = dLf(r, h, v, w, vlo, rv) { (w=wUp__ | w=wLo__) & Limpl__(r,h,v,w,vlo,rv) };

val motion = dLp{ { r'=-rv, h'=-v, v'=a & w*v>=w*vlo | w*a>=alo() } };

////////////////
// Automation //
////////////////

// Find the index of the last expression in a list that matches a pattern.
// Returns null if no such expression could be found.
val findIndex = function(pattern, exprs) {
  var found = null;
  var i = exprs.length;
  while (found == null && i > 0) {
    i = i - 1;
    if (pattern.matches(exprs(i))) {
      found = i;
    };
  };
  found
};

// Find the position of the last antecedent expression that matches a pattern.
// Returns null if no such expression could be found.
val findAnte = function(pattern, sequent) {
  var found = findIndex(pattern, sequent.ante);
  if (found != null) found = -(found + 1);
  found
};

// Find the position of the last succedent expression that matches a pattern.
// Returns null if no such expression could be found.
val findSucc = function(pattern, sequent) {
  var found = findIndex(pattern, sequent.succ);
  if (found != null) found = found + 1;
  found
};

// Find the position of the last antecedent or succedent expression that matches a pattern.
// Returns null if no such expression could be found.
val find = function(pattern, sequent) {
  var found = findAnte(pattern, sequent);
  if (found == null) found = findSucc(pattern, sequent);
  found
};

// Like findAnte, but search in the current goal.
val atAnte = function(pattern) findAnte(pattern, goal());

// Like findSucc, but search in the current goal.
val atSucc = function(pattern) findSucc(pattern, goal());

// Like find, but search in the current goal.
val at = function(pattern) find(pattern, goal());

// Apply belle.andL repeatedly on all premises.
val andLAll = backward[$premise] -> $conclusion {
  var changed = true;
  while (changed) {
    changed = false;

    val pos = findAnte(dLf!{ a__ & b__ }, $conclusion);
    if (pos != null) {
      $conclusion := belle.andL(pos)[$conclusion];
      changed = true;
    }
  };

  $conclusion := $premise;
};

//////////////////////////////////////
// Lemma: Safe use case lower bound //
//////////////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction

val lem_safeUseCaseLowerBound = verified theorem
  dLs{
    loopInv__(r, h, v, w, vlo, rv),
    init__(rv)
  ==>
    abs__(r)>rp() | abs__(h)>hp()
  }
  by backward :=
  core.Expand("init__", "loopInv__") :<
  andLAll :<
  core.Expand("Limpl__") :<
  belle.allL(atAnte(dLf!{ \forall t a__ }), dLt{ 0 }) :<
  belle.allL(atAnte(dLf!{ \forall ro a__ }), dLt{ 0 }) :<
  belle.allL(atAnte(dLf!{ \forall ho a__ }), dLt{ 0 }) :<
  belle.fullSimplify :<
  belle.implyL(atAnte(dLf!{ a__ -> b__ }))[
    core.ExpandAll :< belle.QE[],
    core.ExpandAll :< belle.QE[],
  ];

print("lem_safeUseCaseLowerBound proved");

/////////////////////////////
// Lemma: Safe lower bound //
/////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity bound
//
// a

val lem_safeLowerBound = verified theorem
  dLs{
  ==>
      (w*v >= w*vlo | w*a >= alo())
    & (w=wUp__ | w=wLo__)
    & Limpl__(r, h, v, w, vlo, rv)
    & init__(rv)
    ->
    [motion__;]((w=wUp__ | w=wLo__) & Limpl__(r, h, v, w, vlo, rv))
  }
  by backward -> $conclusion {
    $conclusion :=
    belle.implyR(1) :<
    belle.boxAnd(1) :<
    belle.andR(1)[
      // [motion](w=wUp|w=wLo)
      core.Expand("motion__") :<
      belle.GV(1) :<
      belle.propClose[],

      // [motion]Limpl
      _,
    ] :<
    core.Expand("motion__") :<
    belle.solve(1) :<
    belle.allR(1) :<
    belle.implyR(1) :<
    belle.implyR(1) :<
    belle.allL(atAnte(dLf!{ \forall s_ a__ }), dLt{ t_ }) :<
    belle.simplify(atAnte(dLf!{ 0<=t_ & t_<=t_ -> a__ })) :<
    core.Expand("Limpl__") :<
    belle.allR(1) :<
    belle.allR(1) :<
    belle.allR(1) :<
    andLAll :<
    belle.allL(atAnte(dLf!{ \forall t a__ }), dLt{ t_+t }) :<
    belle.allL(atAnte(dLf!{ \forall ro a__ }), dLt{ rv*(t_+t) }) :<
    belle.cut(dLf{
      0 <= t+t_ & t+t_ < maxI__(v,w,vlo) / alo() | t+t_ >= maxI__(v,w,vlo) / alo()
    })[$use, $show];

    $show :=
    belle.implyR(1) :<
    core.Keep(
      atAnte(dLf!{ t_>=0 }),
      atAnte(dLf!{ w=wUp__()|w=wLo__() }),
      atAnte(dLf!{ init__(rv) }),
      atAnte(dLf!{ 0<=t & t<a__ & ro=b__ & ho=c__ | t>=d__ & ro=e__ & ho=f__ }),
      atSucc(dLf!{ 0<=t+t_ & t+t_<a__ | t+t_>=b__ }),
    ) :<
    core.ExpandAll :<
    belle.QE[];

    $use :=
    belle.implyR(1) :<
    belle.orL(atAnte(dLf!{ 0<=t+t_ & t+t_<a__ | t+t_>=b__ }))[
      // 0<=t+t_&t+t_ < maxI__(v,w,vlo)/alo()
      belle.allL(at(dLf!{ \forall ho a__ }), dLt{ w*alo()/2*(t+t_)^2+v*(t+t_) }) :<
      belle.implyL(at(dLf!{ a__ -> b__ }))[
        belle.orR(at(dLf!{ 0<=t_+t & a__ | b__ })) :<
        core.Keep(
          atAnte(dLf!{ t_>=0 }),
          atAnte(dLf!{ w*(a*t_+v) >= w*vlo | w*a >= alo() }),
          atAnte(dLf!{ w*v        >= w*vlo | w*a >= alo() }),
          atAnte(dLf!{ w=wUp__() | w=wLo__() }),
          atAnte(dLf!{ 0<=t+t_ & t+t_<maxI__(v,w,vlo)/alo() }),
          atAnte(dLf!{ 0<=t & t<a__ & ro=b__ & ho=c__ | t>=d__ & ro=e__ & ho=f__ }),
          atSucc(dLf!{ 0<=t_+t & t_+t<a__ & b__ }),
        ) :<
        core.ExpandAll :<
        belle.QE[],

        belle.prop[ ..core.ExpandAll[belle.QE[]] ],
      ],

      // t+t_>=maxI__(v,w,vlo)/alo()
      belle.orR(1) :<
      belle.allL(atAnte(dLf!{ \forall ho a__ }), dLt{ vlo*(t+t_)-w*maxI__(v,w,vlo)^2/(2*alo()) }) :<
      belle.implyL(atAnte(dLf!{ a__ -> b__ }))[
        belle.orR(atSucc(dLf!{ a__ | b__})) :<
        core.Keep(
          atAnte(dLf!{ t_>=0 }),
          atAnte(dLf!{ t+t_>=maxI__(v,w,vlo)/alo() }),
          atAnte(dLf!{ 0<=t & t<a__ & ro=b__ & ho=c__ | t>=d__ & ro=e__ & ho=f__ }),
          atSucc(dLf!{ t_+t>=a__ & b__ }),
        ) :<
        core.ExpandAll :<
        belle.QE[],

        belle.prop[ ..core.ExpandAll[belle.QE[]] ],
      ],
    ];
  };

print("lem_safeLowerBound proved");

/////////////////////////////////////////////////////
// Theorem 1: Correctness of implicit safe regions //
/////////////////////////////////////////////////////

// Horizontal
//
// r: Relative distance in ft
//   xi - xo
//   x = r
//
// rv: Relative speed
//   -(vi - vo)

// Vertical
//
// h: Relative altitude in ft
//   If negative, the intruder is lower than the ownship.
//   h := hi - ho
//   z = h
//
// v: Vertical velocity of ownship
//
// vlo: Target minimum velocity
//
// w: Velocity direction
//
// a

val thm1_correctnessOfImplicitSafeRegions = verified theorem
  dLs{
  ==>
      init__(rv)
    & ( (w=wUp__ | w=wLo__) & Limpl__(r,h,v,w,vlo,rv) )
    ->
    [{ {
       { ?true;
         ++
         {{ w:=wUp__; ++ w:=wLo__; }
          vlo := *;
          ?Limpl__(r,h,v,w,vlo,rv);
         }
       }
       a := *;
       }
       motion__;
     }*
    ] ( (abs__(r) > rp() | abs__(h) > hp()) & Limpl__(r,h,v,w,vlo,rv) )
  }
  by backward -> $conclusion {
    $conclusion :=
    belle.implyR(1) :<
    andLAll :<
    core.Expand("init__", "motion__") :<
    belle.loop(1, dLf{ loopInv__(r,h,v,w,vlo,rv) })[$init, $post, $step];

    $init :=
    core.ExpandAll :<
    belle.propClose[];

    $post :=
    belle.andR(1)[
      // abs__(r)>rp()|abs__(h)>hp()
      core.Use(lem_safeUseCaseLowerBound)[],

      // Limpl__(r,h,v,w,vlo,rv)
      core.ExpandAll :<
      belle.propClose[],
    ];

    $step :=
    belle.composeb(1) :<
    belle.MR(1, dLf{ loopInv__(r,h,v,w,vlo,rv) & init__(rv) })[
      belle.chaseAt(1) :<
      core.ExpandAll :<
      belle.simplify(1) :<
      belle.closeT[],

      belle.diffUnpackEvolDomain(1) :<
      core.Use(lem_safeLowerBound)[],
    ];
  };

print("thm1_correctnessOfImplicitSafeRegions proved");
