                        randomb('L=="[vlo:=*;][?Limpl(r,h,v,wLo(),vlo,rv);][a:=*;][{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}]((abs(r)>rp()|abs(h)>hp())&Limpl(r,h,v,wLo(),vlo,rv))");
                        allR('R=="\forall vlo [?Lexpl(r,h,v,wLo(),vlo,rv);][a:=*;][{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}]((abs(r)>rp()|abs(h)>hp())&Limpl(r,h,v,wLo(),vlo,rv))");
