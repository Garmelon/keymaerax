                    andR('R=="[w:=wUp();][vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}]((abs(r)>rp()|abs(h)>hp())&Limpl(r,h,v,w,vlo,rv))&[w:=wLo();][vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}]((abs(r)>rp()|abs(h)>hp())&Limpl(r,h,v,w,vlo,rv))"); <(
