/* Exported from KeYmaera X v5.1.1 */

Theorem "ACAS X/Corollary 1: Correctness of explicit safe regions"

Definitions
  import kyx.math.{min,max,abs};
  Real hp;   /* puck height */
  Real rp;   /* puck radius */
  Real alo;  /* minimal vertical acceleration. Typically g/4 */

  /* velocity bound 1 = lower, -1 = upper */
  Real wUp = -1;
  Real wLo = 1;

  /* Explicit */
  Bool case1(Real r, Real v, Real w, Real vlo, Real rv)  <-> -rp <= r & r < -rp - rv * minI(v,w)/alo;
  Bool bound1(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> w * rv^2 * h < alo/2 * (r + rp)^2 + w * rv * v * (r+rp) - rv^2 * hp;
  Bool case2(Real r, Real v, Real w, Real vlo, Real rv)  <-> -rp - rv * minI(v,w)/alo <= r & r <= rp - rv * minI(v,w)/alo;
  Bool bound2(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> w * h < (-(minI(v,w)^2))/(2*alo) - hp;
  Bool case3(Real r, Real v, Real w, Real vlo, Real rv)  <-> rp - rv * minI(v,w)/alo < r & r <= rp + rv * maxI(v,w,vlo)/alo;
  Bool bound3(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> w * rv^2 * h < alo/2 * (r - rp)^2 + w * rv * v * (r - rp) - rv^2 * hp;
  Bool case4(Real r, Real v, Real w, Real vlo, Real rv)  <-> rp + rv * maxI(v,w,vlo)/alo < r;
  Bool bound4(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> rv = 0 | w * rv * h  <  w * vlo * (r - rp) - rv * maxI(v,w,vlo)^2/(2*alo) - rv * hp;
  Bool case5(Real r, Real v, Real w, Real vlo, Real rv)  <-> -rp <= r & r < -rp + rv * maxI(v,w,vlo)/alo;
  Bool bound5(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> w * rv^2 * h < alo/2 * (r + rp)^2 + w * rv * v * (r + rp) - rv^2 * hp;
  Bool case6(Real r, Real v, Real w, Real vlo, Real rv)  <-> -rp + rv * maxI(v,w,vlo)/alo <= r;
  Bool bound6(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> ( (rv = 0 & r > rp)
                    | w * rv * h <  w * vlo * (r + rp) - rv * maxI(v,w,vlo)^2/(2*alo) - rv * hp );
  Bool Lexpl(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> (
    (w * vlo >= 0 ->
        (case1(r,v,w,vlo,rv) -> bound1(r,h,v,w,vlo,rv))
      & (case2(r,v,w,vlo,rv) -> bound2(r,h,v,w,vlo,rv))
      & (case3(r,v,w,vlo,rv) -> bound3(r,h,v,w,vlo,rv))
      & (case4(r,v,w,vlo,rv) -> bound4(r,h,v,w,vlo,rv))
    )
    &
    (w * vlo < 0 ->
        (case5(r,v,w,vlo,rv) -> bound5(r,h,v,w,vlo,rv))
      & (case6(r,v,w,vlo,rv) -> bound6(r,h,v,w,vlo,rv))
    )
  );
  
  /* Implicit */
  Real minI(Real v, Real w) = min(0, v*w);
  Real maxI(Real v, Real w, Real vlo) = max(0, w * (vlo - v));
  Bool Limpl(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> 
    \forall t \forall ro \forall ho (
        (0 <= t & t < maxI(v,w,vlo)/alo & ro = rv * t & ho = (w * alo)/2 * t^2 + v * t)
      | (t >= maxI(v,w,vlo)/alo & ro = rv * t & ho = vlo * t - w * maxI(v,w,vlo)^2/(2*alo))
      -> (abs(r - ro) > rp | w * h < w * ho - hp)
    );

  Bool init(Real rv) <-> rp>=0 & hp>0 & rv>=0 & alo>0;

  Bool loopInv(Real r, Real h, Real v, Real w, Real vlo, Real rv) <-> ( (w=wUp | w=wLo) & Limpl(r,h,v,w,vlo,rv) );
  
  HP motion ::= { {r' = -rv, h' = -v, v' = a & w*v>=w*vlo|w*a>=alo } };
End.

ProgramVariables

  /* horizontal */
  Real r;    /* relative distance in ft; xi - xo */
             /* x = r */
  Real rv;   /* relative speed -(vi - vo) */

  /* vertical */
  Real h;    /* relative altitude in ft */
             /* if negative: the intruder is lower than the ownship */
             /* h := hi - ho */
             /* z = h */
  Real v;    /* vertical velocity of ownship */
  Real vlo;  /* target minimum velocity */
  Real w;    /* velocity direction */
  Real a;

End.

Problem
    init(rv)
  & ( (w=wUp | w=wLo) & Lexpl(r,h,v,w,vlo,rv) )
  ->
  [{ {
     { ?true;
       ++
       {{ w:=wUp; ++ w:=wLo; }
        vlo := *;
        ?Lexpl(r,h,v,w,vlo,rv);
       }
     }
     a := *;
     }
     motion;
   }*@invariant(loopInv(r,h,v,w,vlo,rv))
  ] ( (abs(r) > rp | abs(h) > hp) & Lexpl(r,h,v,w,vlo,rv) )
End.

Tactic "ACAS X/Corollary 1: Correctness of implicit safe regions: Proof"
unfold;
loopRule("loopInv(r,h,v,w,vlo,rv)&init(rv)", 'R=="[{{{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);}a:=*;}motion{|^@|};}*]((abs(r)>rp()|abs(h)>hp())&Lexpl(r,h,v,w,vlo,rv))"); <(
  "Init":
    expand("loopInv");
    fullSimplify;
    cut("init(rv)&(w=wUp()|w=wLo())->(Lexpl(r,h,v,w,vlo,rv)<->Limpl(r,h,v,w,vlo,rv))"); <(
      "Use":
        propClose,
      "Show":
        cohideR('Rlast);
        todo//useLemma("ACAS X/Lemma 1: Equivalence of explicit safe regions", "id")
    ),
  "Step":
    cut("[{{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);}a:=*;}motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))"); <(
      "Use":
        composeb('L=="[{{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);}a:=*;}motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        composeb('R=="[{{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);}a:=*;}motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        composeb('L=="[{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);}a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        composeb('R=="[{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);}a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        choiceb('L=="[?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        choiceb('R=="[?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        andL('L=="[?true;][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))&[{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        andR('R=="[?true;][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))&[{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))"); <(
          "[?true;][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))":
            id,
          "[{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))":
            hideL('L=="[?true;][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
            chaseAt('L=="[{w:=wUp();++w:=wLo();}vlo:=*;?Limpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
            chaseAt('R=="[{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);][a:=*;][motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
            expand("motion");
            unfold; <(
              "\forall w (w=wUp()->\forall vlo (Lexpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))":
                hideL('L=="\forall w (w=wLo()->\forall vlo (Limpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))");
                allL("wUp()", 'L=="\forall w (w=wUp()->\forall vlo (Limpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))");
                fullSimplify;
                allL2R('L=="w=wUp()");
                allL("vlo", 'L=="\forall vlo (Limpl(r,h,v,wUp(),vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&wUp()*v>=wUp()*vlo|wUp()*a>=alo()}](loopInv(r,h,v,wUp(),vlo,rv)&init(rv)))");
                implyL('L=="Limpl(r,h,v,wUp(),vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&wUp()*v>=wUp()*vlo|wUp()*a>=alo()}](loopInv(r,h,v,wUp(),vlo,rv)&init(rv))"); <(
                  "Limpl(r,h,v,wUp(),vlo,rv)":
                    cut("init(rv)&(w=wUp()|w=wLo())->(Lexpl(r,h,v,w,vlo,rv)<->Limpl(r,h,v,w,vlo,rv))"); <(
                      "Use":
                        allL2R('L=="w=wUp()");
                        fullSimplify;
                        closeTrue('R=="true"),
                      "Show":
                        cohideR('Rlast);
                        todo//useLemma("ACAS X/Lemma 1: Equivalence of explicit safe regions", "id")
                    ),
                  "\forall a [{r'=-rv,h'=-v,v'=a&wUp()*v>=wUp()*vlo|wUp()*a>=alo()}](loopInv(r,h,v,wUp(),vlo,rv)&init(rv))":
                    allL("a", 'L=="\forall a [{r'=-rv,h'=-v,v'=a&wUp()*v>=wUp()*vlo|wUp()*a>=alo()}](loopInv(r,h,v,wUp(),vlo,rv)&init(rv))");
                    id
                ),
              "\forall w (w=wLo()->\forall vlo (Lexpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))":
                hideL('L=="\forall w (w=wUp()->\forall vlo (Limpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))");
                allL("wLo()", 'L=="\forall w (w=wLo()->\forall vlo (Limpl(r,h,v,w,vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&w*v>=w*vlo|w*a>=alo()}](loopInv(r,h,v,w,vlo,rv)&init(rv))))");
                fullSimplify;
                allL("vlo", 'L=="\forall vlo (Limpl(r,h,v,wLo(),vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}](loopInv(r,h,v,wLo(),vlo,rv)&init(rv)))");
                implyL('L=="Limpl(r,h,v,wLo(),vlo,rv)->\forall a [{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}](loopInv(r,h,v,wLo(),vlo,rv)&init(rv))"); <(
                  "Limpl(r,h,v,wLo(),vlo,rv)":
                    cut("init(rv)&(w=wUp()|w=wLo())->(Lexpl(r,h,v,w,vlo,rv)<->Limpl(r,h,v,w,vlo,rv))"); <(
                      "Use":
                        allL2R('L=="w=wLo()");
                        fullSimplify;
                        closeTrue('R=="true"),
                      "Show":
                        cohideR('Rlast);
                        todo//useLemma("ACAS X/Lemma 1: Equivalence of explicit safe regions", "id")
                    ),
                  "\forall a [{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}](loopInv(r,h,v,wLo(),vlo,rv)&init(rv))":
                    allL("a", 'L=="\forall a [{r'=-rv,h'=-v,v'=a&wLo()*v>=wLo()*vlo|wLo()*a>=alo()}](loopInv(r,h,v,wLo(),vlo,rv)&init(rv))");
                    allL2R('L=="w=wLo()");
                    id
                )
            )
        ),
      "Show":
        hideR('R=="[{{?true;++{w:=wUp();++w:=wLo();}vlo:=*;?Lexpl(r,h,v,w,vlo,rv);}a:=*;}motion{|^@|};](loopInv(r,h,v,w,vlo,rv)&init(rv))");
        todo
    ),
  "Post":
    andR('R=="(abs(r)>rp()|abs(h)>hp())&Lexpl(r,h,v,w,vlo,rv)"); <(
      "abs(r)>rp()|abs(h)>hp()":
        todo//useLemma("ACAS X/Safe use case lower bound", "prop"),
      "Lexpl(r,h,v,w,vlo,rv)":
        cut("init(rv)&(w=wUp()|w=wLo())->(Lexpl(r,h,v,w,vlo,rv)<->Limpl(r,h,v,w,vlo,rv))"); <(
          "Use":
            expand("loopInv") ; propClose,
          "Show":
            cohideR('Rlast);
            todo//useLemma("ACAS X/Lemma 1: Equivalence of explicit safe regions", "id")
        )
    )
)
End.

End.
