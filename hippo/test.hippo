val dOne = dLt{ 1 };
val dAdd = dLt{ ._0 + ._1 };
val dEq = dLf{ ._0 = ._1 };
//val dNot = dLf{ !._0 };
val dInc = dLp{ x := x + 1; };

print(dLt{ dOne__ + 2 });
print(dLt{ dAdd__(1, 2) + 3 });
print(dLt{ dAdd__(dOne__, 2) + 3 });
print(dLf{ !dEq__(1, 2) });
//print(dLf{ dNot__{true} });
print(dLp{ x := *; dInc__; });
