val dOne = dLt{ 1 };
val dTwo = 2;

val dAdd = dLt(x, y) { x + y };
print("dAdd: ", dAdd);

val dEq = dLf(x, y) { x = y & \exists x x = 3 };
print("dEq:  ", dEq);

val dNot = dLfp(x){ !x };
print("dNot: ", dNot);

val dInc = dLp{ x := x + 1; };
print("dInc: ", dInc);

print(dLt{ dOne__ + dTwo__ });
print(dLt{ dAdd__(1, 2) + 3 });
print(dLt{ dAdd__(dOne__, 2) + 3 });
print(dLf{ !dEq__(1, 2) });
print(dLf{ dNot__{1=2} });
print(dLf{ dNot__{dEq__(dAdd__(dOne__, dOne__), dTwo__)} });
print(dLp{ x := *; dInc__; });
