val branch =
    theorem dLs{ ==> x>0 }
    given dLs{ ==> x=1 }
    given dLs{ ==> x=2 }
    given dLs{ ==> x=3 }
    by core.Sorry();

print("branch: ", branch);

val foo = backward[$p2, $p3, $p1] -> $c {
    $c = core.Unify(branch)[$p1, $p2, $p3];
};

print("foo: ", foo);

val bar = foo.backward(dLs{ ==> x>0 });

print("bar: ", bar);
