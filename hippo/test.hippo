val seq = dLs{ a, b, c ==> d, e, f };
print(seq);

val seqPacked = core.Unpack().forward(seq).conclusion;
print(seqPacked);

val seqUnpacked = core.Unpack().backward(seqPacked).premises(0);
print(seqUnpacked);

if (seq == seqUnpacked){
    print("packing and unpacking did not change seq :)");
} else {
    print("packing and unpacking changed seq :(");
};
