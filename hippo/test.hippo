val dOne = dLt{ 1 };

val dAdd = dLt(x, y) { x + y };
print("dAdd: ", dAdd);

val dEq = dLf(x, y) { x = y & \exists x x = 3 };
print("dEq:  ", dEq);

//val dNot = dLf{ !._0 };

val dInc = dLp{ x := x + 1; };

print(dLt{ dOne__ + 2 });
print(dLt{ dAdd__(1, 2) + 3 });
print(dLt{ dAdd__(dOne__, 2) + 3 });
print(dLf{ !dEq__(1, 2) });
//print(dLf{ dNot__{true} });
print(dLp{ x := *; dInc__; });
